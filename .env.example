# ============================================================
# Periodic Table 3D Game — Environment Variables
# Copy this file to .env and fill in the values before running.
# NEVER commit .env to version control.
# ============================================================

# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://gameuser:gamepassword@postgres:5432/periodic_table_game

# PostgreSQL individual credentials (used by the postgres service in docker-compose)
POSTGRES_USER=gameuser
POSTGRES_PASSWORD=gamepassword
POSTGRES_DB=periodic_table_game

# JWT signing secret — use a long, random string (min 32 chars)
JWT_SECRET=change_me_to_a_long_random_secret_string

# Refresh token signing secret — must differ from JWT_SECRET
REFRESH_SECRET=change_me_to_a_different_long_random_secret

# Redis connection URL
# Format: redis://<host>:<port>
REDIS_URL=redis://redis:6379

# HMAC secret for signing trivia question tokens
HMAC_SECRET=change_me_to_another_long_random_secret

# Allowed origin for CORS (the URL the frontend is served from)
CLIENT_ORIGIN=http://localhost

# Port the backend Express server listens on
PORT=3001
